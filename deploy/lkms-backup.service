# Nightly LKMS backup. Install with the timer: see docs/BACKUPS.md.
[Unit]
Description=LKMS database and uploaded-files backup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=lkms
Group=lkms
UMask=0077
WorkingDirectory=/srv/lkms/backend
ExecStart=/srv/lkms/backend/.venv/bin/python manage.py backup
Nice=10
