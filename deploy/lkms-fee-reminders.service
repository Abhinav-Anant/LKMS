# Daily fee reminders (queued for WhatsApp). See docs/FEES.md.
[Unit]
Description=LKMS fee reminders
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=lkms
Group=lkms
WorkingDirectory=/srv/lkms/backend
ExecStart=/srv/lkms/backend/.venv/bin/python manage.py send_fee_reminders
