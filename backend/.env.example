# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (matches docker-compose.yml). Leave empty to use SQLite in development.
DATABASE_URL=postgres://lkms:lkms@localhost:5432/lkms

# Student documents live here, outside any public web folder.
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=5

LOG_LEVEL=INFO

# Fee payment links point here
FRONTEND_BASE_URL=http://localhost:8080

# The school's UPI account, logo and other details are set in the app (School settings) or by
# `manage.py setup_school`, not here.

# WhatsApp alerts (see docs/WHATSAPP.md). Off until the school's number is linked.
WHATSAPP_ENABLED=false
WHATSAPP_API_URL=http://127.0.0.1:3001
WHATSAPP_API_KEY=
WHATSAPP_RATE_PER_MINUTE=8
WHATSAPP_DAILY_LIMIT_PER_NUMBER=6
WHATSAPP_QUIET_HOURS=21,7

# Backups (docs/BACKUPS.md). Keep BACKUP_DIR on a disk that has room for about 35 backups.
BACKUP_DIR=
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
# Optional off-site copy after each backup; {file} is replaced with the backup's path.
BACKUP_COPY_COMMAND=
