# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (matches docker-compose.yml). Leave empty to use SQLite in development.
DATABASE_URL=postgres://lkms:lkms@localhost:5432/lkms

# Student documents live here, outside any public web folder.
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=5

LOG_LEVEL=INFO

# Fee payment links point here
FRONTEND_BASE_URL=http://localhost:8080

# School UPI account shown to parents (the QR image is frontend/public/school-upi-qr.jpeg)
SCHOOL_UPI_ID=8619190956@SBI
SCHOOL_UPI_NAME=Lotus Kids Education Society
