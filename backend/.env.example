# Copy to backend/.env for local development. Never commit the real .env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG is false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# PostgreSQL (matches docker-compose.yml). Leave empty to use SQLite in development.
DATABASE_URL=postgres://lkms:lkms@localhost:5432/lkms

# Student documents live here, outside any public web folder.
PRIVATE_MEDIA_ROOT=
MAX_UPLOAD_SIZE_MB=5

LOG_LEVEL=INFO

# Payment links and Cashfree callbacks
FRONTEND_BASE_URL=http://localhost:8080
PUBLIC_API_BASE_URL=http://localhost:8000

# Cashfree (https://merchant.cashfree.com > Developers > API keys). Sandbox until go-live.
# The webhook URL to add in the Cashfree dashboard is <PUBLIC_API_BASE_URL>/api/v1/fees/cashfree/webhook/
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
